# ==============================================================================
# GRADWAY EDUCATION CONSULTANCY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# ⚠️ SECURITY NOTICE:
# DO NOT put real API keys, passwords, or production secrets in this file.
# This file (.env.example) is committed to version control as a template.
#
# To use these variables locally:
# 1. Copy this file to a new file named: .env
# 2. Fill in your actual values in the .env file.
# 3. .env is already in .gitignore and will NEVER be pushed to GitHub/Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE PRIVATE SECRETS (Node.js backend only)
# ------------------------------------------------------------------------------
# These variables are ONLY accessible on the server (server.ts).
# They are NEVER exposed to the user's browser or bundled in frontend JavaScript.
# Note: In Google AI Studio, GEMINI_API_KEY is automatically provided by the platform.
GEMINI_API_KEY=
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE PUBLIC VARIABLES (Vite frontend)
# ------------------------------------------------------------------------------
# Variables prefixed with "VITE_" are embedded into the client-side JavaScript.
# ONLY put public, non-sensitive information here (phone numbers, titles, emails).
# NEVER put private API secrets with a VITE_ prefix.
VITE_APP_TITLE="Gradway Education Consultancy"
VITE_CONTACT_PHONE="+94775009929"
VITE_CONTACT_EMAIL="info@gradwayedu.com"
VITE_WHATSAPP_NUMBER="94775009929"
VITE_OFFICE_ADDRESS="Colombo 03, Sri Lanka"
